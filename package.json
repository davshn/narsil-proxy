{
  "name": "narsil-proxy",
  "version": "0.1.0",
  "description": "Narsil: a floating Windows desktop assistant that triages Gmail and reminds you of Google Calendar meetings.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.narsil.desktop",
    "productName": "Narsil",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "icons",
        "filter": [
          "*.png"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon-oscuro.ico"
    },
    "nsis": {
      "createStartMenuShortcut": true,
      "shortcutName": "Narsil"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon-512.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@azure/msal-node": "^7.2.3",
    "@googleapis/calendar": "^20.2.0",
    "@googleapis/gmail": "^22.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.2",
    "google-auth-library": "^11.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
